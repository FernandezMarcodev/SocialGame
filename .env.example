# =============================================================================
# "Es un 10 pero…" — Configuración de entorno
# -----------------------------------------------------------------------------
# Copiá este archivo a `.env` y completá los valores.
# Para hostear en producción, basta con reemplazar estos datos (sobre todo la
# base de datos y el email). Nada más se edita.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Hay dos modos:
#
# 1) Base de datos gestionada externa (Render, Railway, Supabase, Fly, etc.).
#    Pegá la URL completa que te da el proveedor. Si está definida, el
#    contenedor de Postgres local NO se usa (ver docker-compose.prod.yml).
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
#
# 2) Postgres dentro del mismo docker-compose (desarrollo / VPS propio).
#    Completá estas variables; la URL interna se arma sola.
POSTGRES_USER=es10p
POSTGRES_PASSWORD=es10p
POSTGRES_DB=es10p

# --- API ---------------------------------------------------------------------
PORT=8000
DEBUG=false
REDIS_URL=

# Seguridad de tokens (en segundos)
TOKEN_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=300

# --- Email -------------------------------------------------------------------
# "console" imprime los códigos de verificación en los logs (desarrollo).
# "smtp"    envía correos reales (producción).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Juego -------------------------------------------------------------------
ROOM_MIN_PLAYERS=2
ROOM_MAX_PLAYERS=6
AUTHOR_TIMEOUT_SECONDS=90
VOTING_TIMEOUT_SECONDS=45

# --- Avatares ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_AVATAR_BYTES=2000000
# Almacenamiento de avatares: "local" (filesystem, se pierde al reiniciar) o "s3" (S3-compatible: AWS S3, Cloudflare R2, MinIO, Supabase Storage, etc.)
AVATAR_STORAGE=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=
